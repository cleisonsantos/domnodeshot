{
  "manifest_version": 3,
  "name": "DOMnodeshot",
  "version": "1.1.2",
  "description": "Seleciona elementos, copia imagem no clique/Enter, baixa PNG com Ctrl, copia HTML com Shift e edita com Ctrl+Shift.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "activeTab",
    "tabs",
    "downloads",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-selector": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Ativar/Desativar modo de seleção de elementos"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "domnodeshot@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
